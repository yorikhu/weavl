{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "description": "AIGC content production studio. Every template is a declarative, model-agnostic workflow pack — add a new vertical by shipping data, not code.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm -F @loom/web dev",
    "dev:api": "pnpm -F @loom/api dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist .next node_modules"
  }
}
