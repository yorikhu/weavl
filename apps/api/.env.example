PORT=3001
WEAVL_WEB_ORIGINS=http://localhost:3000
WEAVL_MOCK_DATA_FILE=./data/weavl.mock.json
WEAVL_DEMO_EMAIL=demo@weavl.local
WEAVL_DEMO_PASSWORD=weavl1234

# PostgreSQL is the source of truth; Redis stores sessions/cache; MinIO stores binary assets.
DATABASE_URL=postgresql://weavl:weavl@127.0.0.1:5432/weavl
REDIS_URL=redis://127.0.0.1:6379
WEAVL_REDIS_PREFIX=weavl
WEAVL_LOGIN_MAX_FAILURES=5
WEAVL_LOGIN_LOCK_SECONDS=300
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=weavl
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Provider credentials stay on the API server. Provider/model/channel metadata lives in PostgreSQL.
WEAVL_PROVIDER_TIMEOUT_MS=30000
WEAVL_IMAGE_TIMEOUT_MS=120000
WEAVL_VIDEO_TIMEOUT_MS=30000
WEAVL_PROVIDER_MAX_ATTEMPTS=2
WEAVL_PROVIDER_RETRY_BASE_MS=750
ZENMUX_API_KEY=
