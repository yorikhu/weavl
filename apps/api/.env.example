PORT=3001
WEAVL_WEB_ORIGINS=http://localhost:3000
WEAVL_MOCK_DATA_FILE=./data/weavl.mock.json
WEAVL_DEMO_EMAIL=demo@weavl.local
WEAVL_DEMO_PASSWORD=weavl1234

# PostgreSQL is the source of truth; Redis stores sessions/cache; MinIO stores binary assets.
DATABASE_URL=postgresql://weavl:weavl@127.0.0.1:5432/weavl
REDIS_URL=redis://127.0.0.1:6379
WEAVL_REDIS_PREFIX=weavl
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=weavl
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Provider credentials stay on the API server. Multiple channels can target one logical model.
WEAVL_PROVIDER_TIMEOUT_MS=30000
WEAVL_IMAGE_TIMEOUT_MS=120000
WEAVL_VIDEO_TIMEOUT_MS=30000
VOLCENGINE_BASE_URL=
VOLCENGINE_API_KEY=
VOLCENGINE_TEXT_MODEL=
ALIYUN_BASE_URL=
ALIYUN_API_KEY=
ALIYUN_TEXT_MODEL=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_VERTEX_BASE_URL=https://zenmux.ai/api/vertex-ai
ZENMUX_API_KEY=

# Optional additional/fallback channels. Channels sharing modelId form one internal route pool.
# apiKeyEnv names an environment variable; never put a secret in JSON.
# WEAVL_MODEL_CHANNELS_JSON=[{"id":"channel.direct.deepseek","provider":"deepseek","protocol":"openai-chat","modelKind":"text","modelId":"deepseek-v4.1-flash","remoteModel":"deepseek-v4.1-flash","label":"DeepSeek 直连","baseUrl":"https://api.example.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY","priority":5}]
