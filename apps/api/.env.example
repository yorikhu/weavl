# Local mock API. Copy to apps/api/.env for development.
PORT=3001
WEAVL_WEB_ORIGINS=http://localhost:3000
WEAVL_MOCK_DATA_FILE=./data/weavl.mock.json
WEAVL_DEMO_EMAIL=demo@weavl.local
WEAVL_DEMO_PASSWORD=weavl1234

# Reserved for production storage adapters; setting these does not activate them yet.
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Reserved provider adapters; credentials must stay on the API server.
WEAVL_PROVIDER_TIMEOUT_MS=30000
VOLCENGINE_BASE_URL=
VOLCENGINE_API_KEY=
ALIYUN_BASE_URL=
ALIYUN_API_KEY=
ZENMUX_BASE_URL=
ZENMUX_API_KEY=
