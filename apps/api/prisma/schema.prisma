generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String              @id
  email            String              @unique
  name             String
  passwordHash     String              @map("password_hash")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  account          Account?
  accountEvents    AccountEvent[]
  sessions         Session[]
  assetFolders     AssetFolder[]
  assets           Asset[]
  projectFolders   ProjectFolder[]
  projects         Project[]
  conversations    Conversation[]
  skills           Skill[]
  workflows        Workflow[]
  workflowRuns     WorkflowRun[]
  generationJobs   GenerationJob[]
  generationUsages GenerationUsage[]
  creditLedger     CreditLedgerEntry[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "sessions_expiry_idx")
  @@map("sessions")
}

model Account {
  userId      String  @id @map("user_id")
  plan        String  @default("Free")
  credits     Int     @default(20)
  pendingPlan String? @map("pending_plan")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model AccountEvent {
  id        String    @id
  userId    String    @map("user_id")
  type      String
  title     String
  detail    String
  delta     Int?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "account_events_user_idx")
  @@map("account_events")
}

model AssetFolder {
  id        String        @id
  ownerId   String        @map("owner_id")
  parentId  String?       @map("parent_id")
  name      String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent    AssetFolder?  @relation("AssetFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  AssetFolder[] @relation("AssetFolderTree")
  assets    Asset[]

  @@index([ownerId, parentId], map: "asset_folders_owner_idx")
  @@map("asset_folders")
}

model Asset {
  id          String            @id
  ownerId     String            @map("owner_id")
  folderId    String?           @map("folder_id")
  name        String
  kind        String
  source      String
  sourceId    String?           @map("source_id")
  inLibrary   Boolean           @default(true) @map("in_library")
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder      AssetFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions    AssetVersion[]
  messageRefs MessageAssetRef[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc)], map: "assets_owner_idx")
  @@map("assets")
}

model AssetVersion {
  id          String            @id
  assetId     String            @map("asset_id")
  name        String
  mimeType    String            @map("mime_type")
  size        BigInt
  content     String?
  storageKey  String?           @map("storage_key")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  asset       Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  messageRefs MessageAssetRef[]

  @@index([assetId, createdAt], map: "asset_versions_asset_idx")
  @@map("asset_versions")
}

model ProjectFolder {
  id        String    @id
  ownerId   String    @map("owner_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@map("project_folders")
}

model Project {
  id              String         @id
  ownerId         String         @map("owner_id")
  folderId        String?        @map("folder_id")
  name            String
  coverUrl        String?        @map("cover_url")
  coverStorageKey String?        @map("cover_storage_key")
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner           User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder          ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  canvases        Canvas[]
  conversations   Conversation[]
  workflowRuns    WorkflowRun[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc)], map: "projects_owner_idx")
  @@map("projects")
}

model Canvas {
  id        String   @id
  projectId String   @map("project_id")
  name      String
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  viewport  Json     @default("{\"x\":0,\"y\":0,\"zoom\":1}")
  position  Int      @default(0)
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position], map: "canvases_project_idx")
  @@map("canvases")
}

model Conversation {
  id        String                @id
  ownerId   String                @map("owner_id")
  projectId String?               @map("project_id")
  title     String
  archived  Boolean               @default(false)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project   Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String            @id
  conversationId String            @map("conversation_id")
  role           String
  content        String
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assetRefs      MessageAssetRef[]

  @@index([conversationId, createdAt], map: "conversation_messages_idx")
  @@map("conversation_messages")
}

model MessageAssetRef {
  messageId String              @map("message_id")
  assetId   String              @map("asset_id")
  versionId String              @map("version_id")
  message   ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  asset     Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version   AssetVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([messageId, assetId, versionId])
  @@map("message_asset_refs")
}

model Skill {
  id          String   @id
  ownerId     String?  @map("owner_id")
  title       String
  description String
  content     String
  inputHint   String   @map("input_hint")
  outputKind  String   @map("output_kind")
  visibility  String
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, visibility, updatedAt(sort: Desc)], map: "skills_owner_idx")
  @@map("skills")
}

model Workflow {
  id          String        @id
  ownerId     String?       @map("owner_id")
  title       String
  description String
  category    String
  version     Int           @default(1)
  status      String        @default("draft")
  fields      Json          @default("[]")
  stages      Json          @default("[]")
  graph       Json?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@map("workflows")
}

model WorkflowRun {
  id                 String   @id
  ownerId            String   @map("owner_id")
  workflowId         String   @map("workflow_id")
  workflowVersion    Int      @map("workflow_version")
  definitionSnapshot Json?    @map("definition_snapshot")
  projectId          String?  @map("project_id")
  inputs             Json
  status             String
  stages             Json
  currentStage       Int      @default(0) @map("current_stage")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workflow           Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ownerId, updatedAt(sort: Desc)], map: "workflow_runs_owner_idx")
  @@map("workflow_runs")
}

model ModelProvider {
  id              String              @id
  code            String              @unique
  label           String
  apiKeyEnv       String              @map("api_key_env")
  enabled         Boolean             @default(true)
  metadata        Json                @default("{}")
  pricingAdapter  String?             @map("pricing_adapter")
  pricingUrl      String?             @map("pricing_url")
  lastPriceSyncAt DateTime?           @map("last_price_sync_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  channels        ProviderChannel[]
  priceSyncs      ProviderPriceSync[]

  @@map("model_providers")
}

model ModelDefinition {
  id           String             @id
  kind         String
  label        String
  maker        String
  description  String
  isAuto       Boolean            @default(false) @map("is_auto")
  enabled      Boolean            @default(true)
  capabilities Json               @default("{}")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  channels     ProviderChannel[]
  pricingRules ModelPricingRule[]
  usages       GenerationUsage[]

  @@index([kind, enabled], map: "model_definitions_kind_idx")
  @@map("model_definitions")
}

model ProviderChannel {
  id               String               @id
  providerId       String               @map("provider_id")
  protocol         String               @default("openai-chat")
  modelId          String               @map("model_id")
  remoteModel      String               @map("remote_model")
  label            String
  baseUrl          String               @map("base_url")
  costPricing      Json?                @map("cost_pricing")
  costCurrency     String?              @map("cost_currency")
  costUpdatedAt    DateTime?            @map("cost_updated_at") @db.Timestamptz(6)
  capabilities     Json                 @default("{}")
  weight           Int                  @default(100)
  priority         Int                  @default(100)
  enabled          Boolean              @default(true)
  failureThreshold Int                  @default(3) @map("failure_threshold")
  cooldownSeconds  Int                  @default(60) @map("cooldown_seconds")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  requestLogs      ProviderRequestLog[]
  generationJobs   GenerationJob[]
  generationUsages GenerationUsage[]
  costVersions     ChannelCostVersion[]
  provider         ModelProvider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  model            ModelDefinition      @relation(fields: [modelId], references: [id], onDelete: Restrict)

  @@index([modelId, enabled, weight, priority], map: "provider_channel_route_idx")
  @@index([providerId, enabled], map: "provider_channel_provider_idx")
  @@map("provider_channels")
}

model ProviderPriceSync {
  id           String               @id
  providerId   String               @map("provider_id")
  status       String
  sourceUrl    String               @map("source_url")
  checksum     String?
  payload      Json?
  matchedCount Int                  @default(0) @map("matched_count")
  changedCount Int                  @default(0) @map("changed_count")
  missingCount Int                  @default(0) @map("missing_count")
  errorMessage String?              @map("error_message")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?            @map("completed_at") @db.Timestamptz(6)
  provider     ModelProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  costVersions ChannelCostVersion[]

  @@index([providerId, createdAt(sort: Desc)], map: "provider_price_syncs_provider_idx")
  @@map("provider_price_syncs")
}

model ChannelCostVersion {
  id        String            @id
  channelId String            @map("channel_id")
  syncId    String            @map("sync_id")
  pricing   Json
  currency  String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  channel   ProviderChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sync      ProviderPriceSync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)], map: "channel_cost_versions_channel_idx")
  @@map("channel_cost_versions")
}

model GenerationJob {
  id              String           @id
  ownerId         String           @map("owner_id")
  channelId       String?          @map("channel_id")
  modelKind       String           @map("model_kind")
  modelId         String           @map("model_id")
  remoteOperation String?          @map("remote_operation")
  status          String
  request         Json
  result          Json?
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channel         ProviderChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  usage           GenerationUsage?

  @@index([ownerId, updatedAt(sort: Desc)], map: "generation_jobs_owner_idx")
  @@index([status, updatedAt], map: "generation_jobs_status_idx")
  @@map("generation_jobs")
}

model ModelPricingRule {
  id             String            @id
  modelId        String            @map("model_id")
  name           String
  conditions     Json              @default("{}")
  unitField      String?           @map("unit_field")
  creditsPerUnit Int               @map("credits_per_unit")
  minimumCredits Int               @default(0) @map("minimum_credits")
  priority       Int               @default(100)
  enabled        Boolean           @default(true)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  model          ModelDefinition   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  usages         GenerationUsage[]

  @@index([modelId, enabled, priority], map: "model_pricing_rules_route_idx")
  @@map("model_pricing_rules")
}

model GenerationUsage {
  id              String              @id
  ownerId         String              @map("owner_id")
  jobId           String?             @unique @map("job_id")
  modelId         String              @map("model_id")
  channelId       String?             @map("channel_id")
  pricingRuleId   String?             @map("pricing_rule_id")
  status          String
  inputSnapshot   Json                @map("input_snapshot")
  pricingSnapshot Json                @map("pricing_snapshot")
  credits         Int
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner           User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  job             GenerationJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  model           ModelDefinition     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  channel         ProviderChannel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  pricingRule     ModelPricingRule?   @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  ledgerEntries   CreditLedgerEntry[]

  @@index([ownerId, createdAt(sort: Desc)], map: "generation_usages_owner_idx")
  @@index([modelId, createdAt(sort: Desc)], map: "generation_usages_model_idx")
  @@map("generation_usages")
}

model CreditLedgerEntry {
  id           String           @id
  ownerId      String           @map("owner_id")
  usageId      String?          @map("usage_id")
  type         String
  delta        Int
  balanceAfter Int              @map("balance_after")
  reason       String
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  usage        GenerationUsage? @relation(fields: [usageId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt(sort: Desc)], map: "credit_ledger_owner_idx")
  @@map("credit_ledger_entries")
}

model BillingPolicy {
  id             String   @id
  creditValueCny Decimal  @map("credit_value_cny") @db.Decimal(12, 6)
  markupRate     Decimal  @map("markup_rate") @db.Decimal(8, 6)
  usdCnyRate     Decimal  @map("usd_cny_rate") @db.Decimal(12, 6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("billing_policies")
}

model ProviderRequestLog {
  id           String          @id
  channelId    String          @map("channel_id")
  requestKind  String          @map("request_kind")
  status       String
  latencyMs    Int             @map("latency_ms")
  statusCode   Int?            @map("status_code")
  errorMessage String?         @map("error_message")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  channel      ProviderChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)], map: "provider_logs_channel_idx")
  @@map("provider_request_logs")
}

model LegacyRun {
  id         String   @id
  templateId String   @map("template_id")
  state      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt(sort: Desc)], map: "legacy_runs_updated_idx")
  @@map("legacy_runs")
}
