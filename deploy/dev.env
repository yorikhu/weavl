# Local-only Docker Compose defaults. Production continues to use its private root .env file.
POSTGRES_DB=weavl
POSTGRES_USER=weavl
POSTGRES_PASSWORD=weavl
REDIS_PASSWORD=unused-in-local-development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
WEAVL_PUBLIC_ORIGIN=http://localhost:3000
WEAVL_COOKIE_SECURE=false
WEAVL_DEMO_EMAIL=demo@weavl.local
WEAVL_DEMO_PASSWORD=weavl1234
